# Copy to .env (which git ignores) so nellie doesn't ask where to connect.
# nellie only reads DATABASE_URL from this file; set anything else in your shell.
# The URL must include its password, and can't be combined with PG* settings in your shell.
# A DATABASE_URL already set in your shell takes precedence over this file.
# nellie requires TLS unless sslmode is given; for a local server without TLS, add ?sslmode=disable.
DATABASE_URL=postgres://admin:password@localhost:5432/postgres?sslmode=disable
